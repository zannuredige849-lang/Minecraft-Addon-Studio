{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "studio:odyssey_person",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "studio:anim": {
          "type": "enum",
          "values": [
            "none",
            "point",
            "cheer",
            "hurt"
          ],
          "default": "none",
          "client_sync": true
        },
        "studio:variant": {
          "type": "int",
          "range": [
            0,
            6
          ],
          "default": 3,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "studio:mortal": {
        "minecraft:health": {
          "value": 30,
          "max": 30
        }
      },
      "studio:protected": {
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": false
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "odyssey_person",
          "ithacan",
          "studio_odyssey",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.55,
        "height": 1.8
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:nameable": {
        "always_show": false,
        "allow_name_tag_renaming": false
      },
      "minecraft:movement": {
        "value": 0.27
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_pass_doors": true,
        "can_open_doors": true,
        "can_float": true
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 5,
        "look_distance": 10,
        "probability": 0.6
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:knockback_resistance": {
        "value": 0.9
      },
      "minecraft:persistent": {},
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  }
                ]
              },
              "event": "studio:talk",
              "target": "self"
            },
            "cooldown": 1.5,
            "interact_text": "action.interact.studio.talk"
          }
        ]
      }
    },
    "events": {
      "studio:talk": {},
      "studio:make_mortal": {
        "remove": {
          "component_groups": [
            "studio:protected"
          ]
        },
        "add": {
          "component_groups": [
            "studio:mortal"
          ]
        }
      }
    }
  }
}