{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ship_crew.moves": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "hurt": "q.property('studio:anim') == 'hurt'"
            },
            {
              "cheer": "q.property('studio:anim') == 'cheer'"
            },
            {
              "brace": "q.property('studio:anim') == 'brace'"
            },
            {
              "row": "q.property('studio:anim') == 'row'"
            }
          ]
        },
        "row": {
          "animations": [
            "row"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "hurt": "q.property('studio:anim') == 'hurt'"
            },
            {
              "cheer": "q.property('studio:anim') == 'cheer'"
            },
            {
              "brace": "q.property('studio:anim') == 'brace'"
            },
            {
              "idle": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "brace": {
          "animations": [
            "brace"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "hurt": "q.property('studio:anim') == 'hurt'"
            },
            {
              "row": "q.property('studio:anim') == 'row'"
            },
            {
              "idle": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "cheer": {
          "animations": [
            "cheer"
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "row": "q.property('studio:anim') == 'row'"
            },
            {
              "idle": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "blend_transition": 0.08,
          "transitions": [
            {
              "row": "q.property('studio:anim') == 'row'"
            },
            {
              "idle": "q.property('studio:anim') == 'none'"
            }
          ]
        }
      }
    }
  }
}