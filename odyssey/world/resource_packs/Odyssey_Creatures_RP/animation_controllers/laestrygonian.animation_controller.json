            },
            {
              "hurt": "q.property('studio:anim') == 'hurt'"
            },
            {
              "default": "q.modified_move_speed < 0.03"
            }
          ]
        },
        "slash": {
          "animations": [
            "slash"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "impale": "q.property('studio:anim') == 'impale'"
            },
            {
              "crush": "q.property('studio:anim') == 'crush'"
            },
            {
              "cleave": "q.property('studio:anim') == 'cleave'"
            },
            {
              "smash": "q.property('studio:anim') == 'smash'"
            },
            {
              "hurt": "q.property('studio:anim') == 'hurt'"
            },
            {
              "walk": "q.property('studio:anim') == 'none' && q.modified_move_speed > 0.05"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "impale": {
          "animations": [
            "impale"
          ],
          "blend_transition": 0.12,
          "transitions": [
