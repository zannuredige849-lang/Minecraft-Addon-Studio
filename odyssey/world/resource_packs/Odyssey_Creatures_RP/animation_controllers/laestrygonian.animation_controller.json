{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.laestrygonian.moves": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "slash": "q.property('studio:anim') == 'slash'"
            },
            {
              "impale": "q.property('studio:anim') == 'impale'"
            },
            {
              "crush": "q.property('studio:anim') == 'crush'"
            },
            {
              "cleave": "q.property('studio:anim') == 'cleave'"
            },
            {
              "smash": "q.property('studio:anim') == 'smash'"
            },
            {
              "hurt": "q.property('studio:anim') == 'hurt'"
            },
            {
              "walk": "q.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "slash": "q.property('studio:anim') == 'slash'"
            },
            {
