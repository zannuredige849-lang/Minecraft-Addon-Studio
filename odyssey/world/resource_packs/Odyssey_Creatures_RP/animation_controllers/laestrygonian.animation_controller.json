    },
    "controller.animation.laestrygonian.steps": {
      "initial_state": "still",
      "states": {
        "still": {
          "transitions": [
            {
              "a": "q.modified_move_speed > 0.06 && math.sin(q.modified_distance_moved*90) >= 0.15"
            },
            {
              "b": "q.modified_move_speed > 0.06 && math.sin(q.modified_distance_moved*90) <= -0.15"
            }
          ]
        },
        "a": {
          "sound_effects": [
            {
              "effect": "step"
            }
          ],
          "transitions": [
            {
              "still": "q.modified_move_speed < 0.03"
            },
            {
              "b": "math.sin(q.modified_distance_moved*90) <= -0.15"
            }
          ]
        },
        "b": {
          "sound_effects": [
            {
              "effect": "step"
            }
          ],
          "transitions": [
            {
              "still": "q.modified_move_speed < 0.03"
            },
            {
              "a": "math.sin(q.modified_distance_moved*90) >= 0.15"
            }
          ]
        }
      }
