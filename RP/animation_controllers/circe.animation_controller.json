{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.circe.moves": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle",
            {
              "walk": "q.modified_move_speed > 0.02"
            },
            {
              "yielded": "q.property('studio:yielded')"
            }
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "serve": "q.property('studio:anim') == 'serve'"
            },
            {
              "scream": "q.property('studio:anim') == 'scream'"
            },
            {
              "mold": "q.property('studio:anim') == 'mold'"
            },
            {
              "counsel": "q.property('studio:anim') == 'counsel'"
            }
          ]
        },
        "serve": {
          "animations": [
            "serve"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "scream": "q.property('studio:anim') == 'scream'"
            },
            {
              "mold": "q.property('studio:anim') == 'mold'"
            },
            {
              "counsel": "q.property('studio:anim') == 'counsel'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "scream": {
          "animations": [
            "scream"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "serve": "q.property('studio:anim') == 'serve'"
            },
            {
              "mold": "q.property('studio:anim') == 'mold'"
            },
            {
              "counsel": "q.property('studio:anim') == 'counsel'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "mold": {
          "animations": [
            "mold"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "serve": "q.property('studio:anim') == 'serve'"
            },
            {
              "scream": "q.property('studio:anim') == 'scream'"
            },
            {
              "counsel": "q.property('studio:anim') == 'counsel'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "counsel": {
          "animations": [
            "counsel"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "serve": "q.property('studio:anim') == 'serve'"
            },
            {
              "scream": "q.property('studio:anim') == 'scream'"
            },
            {
              "mold": "q.property('studio:anim') == 'mold'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        }
      }
    },
    "controller.animation.circe.steps": {
      "initial_state": "still",
      "states": {
        "still": {
          "transitions": [
            {
              "a": "q.modified_move_speed > 0.02 && math.sin(q.modified_distance_moved*200) >= 0"
            },
            {
              "b": "q.modified_move_speed > 0.02 && math.sin(q.modified_distance_moved*200) < 0"
            }
          ]
        },
        "a": {
          "sound_effects": [
            {
              "effect": "step"
            }
          ],
          "transitions": [
            {
              "still": "!(q.modified_move_speed > 0.02)"
            },
            {
              "b": "math.sin(q.modified_distance_moved*200) < 0"
            }
          ]
        },
        "b": {
          "sound_effects": [
            {
              "effect": "step"
            }
          ],
          "transitions": [
            {
              "still": "!(q.modified_move_speed > 0.02)"
            },
            {
              "a": "math.sin(q.modified_distance_moved*200) >= 0"
            }
          ]
        }
      }
    }
  }
}
