            }
          ]
        },
        "speak_agamemnon": {
          "animations": [
            "speak_agamemnon"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "rise": "q.property('studio:anim') == 'rise'"
            },
            {
              "sink": "q.property('studio:anim') == 'sink'"
            },
            {
              "speak_sinon": "q.property('studio:anim') == 'speak_sinon'"
            },
            {
              "grasp": "q.property('studio:anim') == 'grasp'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        },
