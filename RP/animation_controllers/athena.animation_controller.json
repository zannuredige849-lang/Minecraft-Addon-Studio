{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.athena.moves": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle",
            {
              "walk": "q.modified_move_speed > 0.02"
            }
          ],
          "blend_transition": 0.15,
          "transitions": [
            {
              "bless": "q.property('studio:anim') == 'bless'"
            },
            {
              "appear": "q.property('studio:anim') == 'appear'"
            },
            {
              "vanish": "q.property('studio:anim') == 'vanish'"
            }
          ]
        },
        "bless": {
          "animations": [
            "bless"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "appear": "q.property('studio:anim') == 'appear'"
            },
            {
              "vanish": "q.property('studio:anim') == 'vanish'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "appear": {
          "animations": [
            "appear"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "bless": "q.property('studio:anim') == 'bless'"
            },
            {
              "vanish": "q.property('studio:anim') == 'vanish'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        },
        "vanish": {
          "animations": [
            "vanish"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "bless": "q.property('studio:anim') == 'bless'"
            },
            {
              "appear": "q.property('studio:anim') == 'appear'"
            },
            {
              "default": "q.property('studio:anim') == 'none'"
            }
          ]
        }
      }
    },
    "controller.animation.athena.steps": {
      "initial_state": "still",
      "states": {
        "still": {
          "transitions": [
            {
              "a": "q.modified_move_speed > 0.02 && math.sin(q.modified_distance_moved*200) >= 0"
            },
            {
              "b": "q.modified_move_speed > 0.02 && math.sin(q.modified_distance_moved*200) < 0"
            }
          ]
        },
        "a": {
          "sound_effects": [
            {
              "effect": "step"
            }
          ],
          "transitions": [
            {
              "still": "!(q.modified_move_speed > 0.02)"
            },
            {
              "b": "math.sin(q.modified_distance_moved*200) < 0"
            }
          ]
        },
        "b": {
          "sound_effects": [
            {
              "effect": "step"
            }
          ],
          "transitions": [
            {
              "still": "!(q.modified_move_speed > 0.02)"
            },
            {
              "a": "math.sin(q.modified_distance_moved*200) >= 0"
            }
          ]
        }
      }
    }
  }
}
