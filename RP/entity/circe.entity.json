{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "studio:circe",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/circe"
      },
      "geometry": {
        "default": "geometry.circe"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "animations": {
        "idle": "animation.circe.idle",
        "walk": "animation.circe.walk",
        "mold": "animation.circe.mold",
        "yielded": "animation.circe.yielded"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "q.modified_move_speed > 0.05"
          },
          {
            "mold": "q.property('studio:anim') == 'mold'"
          },
          {
            "yielded": "q.property('studio:yielded')"
          }
        ]
      },
      "spawn_egg": {
        "base_color": "#743C28",
        "overlay_color": "#3A4630"
      }
    }
  }
}
