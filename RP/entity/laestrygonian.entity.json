{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "studio:laestrygonian",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/laestrygonian"
      },
      "geometry": {
        "default": "geometry.laestrygonian"
      },
      "render_controllers": [
        "controller.render.studio_laestrygonian"
      ],
      "animations": {
        "idle": "animation.laestrygonian.idle",
        "walk": "animation.laestrygonian.walk",
        "swing": "animation.laestrygonian.swing",
        "smash": "animation.laestrygonian.smash"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "q.modified_move_speed > 0.02"
          },
          {
            "swing": "q.property('studio:anim') == 'swing'"
          },
          {
            "smash": "q.property('studio:anim') == 'smash'"
          }
        ],
        "scale": "0.9109"
      },
      "spawn_egg": {
        "base_color": "#B2B6BE",
        "overlay_color": "#4A4E58"
      }
    }
  }
}
