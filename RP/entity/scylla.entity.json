{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "studio:scylla",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/scylla"
      },
      "geometry": {
        "default": "geometry.scylla"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "animations": {
        "idle": "animation.scylla.idle",
        "walk": "animation.scylla.walk",
        "snatch": "animation.scylla.snatch"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "q.modified_move_speed > 0.05"
          },
          {
            "snatch": "q.property('studio:anim') == 'snatch'"
          }
        ]
      },
      "spawn_egg": {
        "base_color": "#686860",
        "overlay_color": "#962F3A"
      }
    }
  }
}
