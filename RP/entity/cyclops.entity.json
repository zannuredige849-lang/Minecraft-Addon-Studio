{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "studio:cyclops",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/cyclops",
        "blinded": "textures/entity/cyclops_blinded"
      },
      "geometry": {
        "default": "geometry.cyclops"
      },
      "render_controllers": [
        "controller.render.studio_cyclops"
      ],
      "animations": {
        "idle": "animation.cyclops.idle",
        "walk": "animation.cyclops.walk",
        "grab": "animation.cyclops.grab",
        "throw": "animation.cyclops.throw",
        "cry": "animation.cyclops.cry",
        "asleep": "animation.cyclops.asleep",
        "blind_search": "animation.cyclops.blind_search"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "q.modified_move_speed > 0.02 && q.property('studio:state') != 'asleep'"
          },
          {
            "grab": "q.property('studio:anim') == 'grab'"
          },
          {
            "throw": "q.property('studio:anim') == 'throw'"
          },
          {
            "cry": "q.property('studio:anim') == 'cry'"
          },
          {
            "asleep": "q.property('studio:state') == 'asleep'"
          },
          {
            "blind_search": "q.property('studio:blind') && q.property('studio:state') != 'asleep'"
          }
        ],
        "scale": "2.2949"
      },
      "spawn_egg": {
        "base_color": "#B0ACA4",
        "overlay_color": "#5C5650"
      }
    }
  }
}
