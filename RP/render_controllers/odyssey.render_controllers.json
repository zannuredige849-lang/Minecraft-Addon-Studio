{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.studio_cyclops": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.blinded"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.property('studio:blind')]"
      ]
    },
    "controller.render.studio_siren": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.dusk",
            "Texture.ash",
            "Texture.sea"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.property('studio:plumage')]"
      ]
    }
  }
}
